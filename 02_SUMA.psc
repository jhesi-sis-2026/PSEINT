Algoritmo EJERCICIO_2
	// REALIZA LA SUMA DE DOS NUMEROS 
	
	//DEFINIR VARIABLES
	Definir numero1, numero2 Como Entero
	Definir suma Como Entero
	
	// ENTRADA 
	Escribir "ingrese el primer numero"
